# Neon Database (Optional - for cloud database)
# Uncomment and configure if using Neon instead of local Supabase
# DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://user:password@host:port/database?sslmode=require"
# PGHOST=your-neon-host
# PGHOST_UNPOOLED=your-neon-host-unpooled
# PGUSER=your-neon-user
# PGDATABASE=your-neon-database
# PGPASSWORD=your-neon-password

# Application Settings
